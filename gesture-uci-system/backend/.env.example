# Configuración de ejemplo para DOCommunication Backend
# Copia este archivo a .env y ajusta los valores

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# CORS Origins (separados por comas)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://*.netlify.app

# MediaPipe Configuration
MEDIAPIPE_DETECTION_CONFIDENCE=0.5
MEDIAPIPE_TRACKING_CONFIDENCE=0.5

# Graph Analysis Configuration
GRAPH_ACTIVATION_THRESHOLD=0.3
GRAPH_NUM_SIMULATIONS=100

# Database Configuration (opcional)
DATABASE_URL=sqlite:///./docommunication.db

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Development
DEBUG=false
